<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Wrench.Contracts</PackageId>
    <Version>1.0.0</Version>
    <Authors>BGT3</Authors>
    <Company>BGT3</Company>
    <Description>Contratos das mensagens da Saga da Wrench Auto Repair: comandos e eventos trocados entre o OS Service, o Billing Service e o Execucao Service.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/euthribeiro/wrench-contracts</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>saga;contracts;wrench;sns;sqs</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
